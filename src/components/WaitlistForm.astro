---
import type { Locale } from "@/i18n";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const T = t(locale).waitlist;
const formId = `waitlist-${locale}`;
const recaptchaSiteKey = "6LfOSv4sAAAAAN_3c-Te-bx_J8mlNm-DuEHBkZpa";
const FORMSPREE_FORM_ID = "meedlbpp";
---

<div id={`${formId}-success`} class="hidden text-accent font-display text-sm text-center py-4">
  {T.success}
</div>
<div id={`${formId}-error`} class="hidden text-danger font-display text-sm text-center py-2"></div>

<form
  id={formId}
  class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
>
  <div class="flex-1">
    <input
      type="email"
      id={`${formId}-email`}
      name="email"
      required
      placeholder={T.placeholder}
      class="input-field w-full"
      autocomplete="email"
    />
    <span id={`${formId}-email-error`} class="text-danger font-display text-xs mt-1 block"></span>
  </div>
  <button
    type="submit"
    id={`${formId}-submit-btn`}
    class="btn-primary whitespace-nowrap"
  >
    {T.cta}
  </button>
</form>

<p class="text-text-muted text-xs text-center mt-4">{T.disclaimer}</p>

<script is:inline>
  (function () {
    var script = document.createElement("script");
    script.src = "https://www.google.com/recaptcha/api.js?render=6LfOSv4sAAAAAN_3c-Te-bx_J8mlNm-DuEHBkZpa";
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  })();
</script>

<script define:vars={{ formId, recaptchaSiteKey, FORMSPREE_FORM_ID, T }}>
  (function () {
    var form = document.getElementById(formId);
    var submitBtn = document.getElementById(formId + "-submit-btn");
    var successEl = document.getElementById(formId + "-success");
    var errorEl = document.getElementById(formId + "-error");
    var emailErrorEl = document.getElementById(formId + "-email-error");
    var emailInput = document.getElementById(formId + "-email");
    var FORM_URL = "https://formspree.io/f/" + FORMSPREE_FORM_ID;

    function waitForRecaptcha(callback, retries) {
      if (retries === undefined) retries = 50;
      if (window.grecaptcha && window.grecaptcha.execute) {
        callback();
        return;
      }
      if (retries > 0) {
        setTimeout(function () {
          waitForRecaptcha(callback, retries - 1);
        }, 100);
      }
    }

    function resetUI() {
      submitBtn.disabled = false;
      submitBtn.textContent = T.cta;
      errorEl.classList.add("hidden");
      errorEl.textContent = "";
      emailErrorEl.textContent = "";
      emailInput.removeAttribute("aria-invalid");
    }

    function showSuccess() {
      form.classList.add("hidden");
      successEl.classList.remove("hidden");
    }

    function showError(message) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      resetUI();

      submitBtn.disabled = true;
      submitBtn.textContent = "...";

      waitForRecaptcha(function () {
        window.grecaptcha
          .execute(recaptchaSiteKey, { action: "submit" })
          .then(function (token) {
            var formData = new FormData(form);
            formData.append("g-recaptcha-response", token);

            return fetch(FORM_URL, {
              method: "POST",
              body: formData,
              headers: { Accept: "application/json" },
            });
          })
          .then(function (response) {
            if (response.ok) {
              showSuccess();
            } else {
              return response.json().then(function (data) {
                if (data.errors && data.errors.length > 0) {
                  var firstError = data.errors[0];
                  if (firstError.field === "email") {
                    emailErrorEl.textContent = firstError.message;
                    emailInput.setAttribute("aria-invalid", "true");
                  }
                  throw new Error(firstError.message || "Submission failed");
                }
                throw new Error(data.error || "Submission failed");
              });
            }
          })
          .catch(function (err) {
            showError(err.message || "Something went wrong. Please try again.");
            submitBtn.disabled = false;
            submitBtn.textContent = T.cta;
          });
      });
    });
  })();
</script>
