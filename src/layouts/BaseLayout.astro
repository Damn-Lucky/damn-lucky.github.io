---
import type { Locale } from "@/i18n";
import { t } from "@/i18n";
import "@/styles/global.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const T = t(locale);

const canonicalUrl = Astro.url.href;
const siteOrigin = Astro.url.origin;
const ogImage = `${siteOrigin}/og.png`;
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const ogLocaleAlt = locale === "es" ? "en_US" : "es_ES";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Damn Luck",
  url: siteOrigin,
  description: T.meta.description,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  inLanguage: locale === "es" ? "es-ES" : "en-US",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: {
    "@type": "Organization",
    name: "Damn Luck",
    url: siteOrigin,
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/favicon.svg`,
    },
  },
};
---

<!doctype html>
<html lang={locale === "es" ? "es-ES" : "en-US"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#00ff88" />

    <!-- Primary SEO -->
    <title>{T.meta.title}</title>
    <meta name="description" content={T.meta.description} />
    <meta name="author" content="Damn Luck" />
    <meta
      name="keywords"
      content={locale === "es"
        ? "mercados deportivos, análisis deportivo, probabilidades, apuestas inteligentes, inteligencia de mercado"
        : "sports markets, sports analysis, odds, smart betting, market intelligence"}
    />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Damn Luck" />
    <meta property="og:title" content={T.meta.title} />
    <meta property="og:description" content={T.meta.description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={T.meta.title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={T.meta.title} />
    <meta name="twitter:description" content={T.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={T.meta.title} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="es" href={`${siteOrigin}/es/`} />
    <link rel="alternate" hreflang="en" href={`${siteOrigin}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/es/`} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary">
    <nav
      class="fixed top-0 left-0 right-0 z-50 bg-bg-primary/80 backdrop-blur-xl border-b border-border"
    >
      <div
        class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between"
      >
        <a href={`/${locale}/`} class="flex items-center gap-3 group">
          <div
            class="w-8 h-8 bg-accent rounded-lg flex items-center justify-center group-hover:shadow-glow transition-all duration-300"
          >
            <span class="font-display font-bold text-bg-primary text-sm"
              >DL</span
            >
          </div>
          <span class="font-display font-semibold text-lg tracking-tight"
            >Damn Luck</span
          >
        </a>

        <a
          href={T.nav.langSwitchHref}
          class="font-display text-xs uppercase tracking-widest text-text-secondary hover:text-accent transition-colors duration-200 border border-border-light hover:border-accent/50 px-3 py-1.5 rounded-md"
        >
          {T.nav.langSwitch}
        </a>
      </div>
    </nav>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-border bg-bg-secondary py-12 mt-20">
      <div class="max-w-7xl mx-auto px-6">
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-6"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-6 h-6 bg-accent rounded flex items-center justify-center"
            >
              <span class="font-display font-bold text-bg-primary text-xs"
                >DL</span
              >
            </div>
            <span class="font-display text-sm text-text-secondary">
              {T.footer.copy}
            </span>
          </div>
          <span
            class="font-display text-xs text-text-muted uppercase tracking-widest"
          >
            {T.footer.tagline}
          </span>
          <div class="flex items-center gap-4">
            <a
              href="/es/"
              class:list={[
                "font-display text-xs uppercase tracking-wider transition-colors",
                locale === "es"
                  ? "text-accent"
                  : "text-text-muted hover:text-accent",
              ]}
            >
              ES
            </a>
            <span class="text-border-light">|</span>
            <a
              href="/en/"
              class:list={[
                "font-display text-xs uppercase tracking-wider transition-colors",
                locale === "en"
                  ? "text-accent"
                  : "text-text-muted hover:text-accent",
              ]}
            >
              EN
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
